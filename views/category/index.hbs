<div class="row mb-3">
    <h1><i class="bi bi-tags"></i> Categorías</h1>
    <hr />
</div>

<div class="row mb-3">
    <div class="col-12">
        <a href="/categories/create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva Categoría
        </a>
    </div>
</div>

{{#if hasCategories}}
<div class="row">
    {{#each categoriesList}}
    <div class="col-12 col-sm-4 col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-tag-fill"></i> {{this.name}}</h5>
                <p class="text-muted small">
                    <i class="bi bi-text-left me-1"></i>{{this.description}}
                </p>
                <div class="mt-3 d-flex gap-2">
                    <a href="/categories/edit/{{this.id}}" class="btn btn-primary btn-sm">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <a href="/categories/delete/{{this.id}}" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash3"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>
{{else}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-5">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay categorías registradas.
        </div>
    </div>
</div>
{{/if}}

{{#section "scripts"}}
 
{{/section}}