<div class="row mb-3">
    <h1>{{#if editMode}}Editar categoría{{else}}Crear categoría{{/if}}</h1>
    <hr />
</div>

<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" action="/categories/{{#if editMode}}edit{{else}}create{{/if}}">
                    {{#if editMode}}
                    <input type="hidden" name="id" value="{{category.id}}">
                    {{/if}}
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">Nombre</label>
                        <input type="text" id="name" name="name" class="form-control"
                            value="{{#if editMode}}{{category.name}}{{else}}{{formData.name}}{{/if}}" required />
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">Descripción</label>
                        <textarea id="description" name="description" class="form-control" rows="3">{{#if editMode}}{{category.description}}{{else}}{{formData.description}}{{/if}}</textarea>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <a href="/categories/index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-{{#if editMode}}primary{{else}}success{{/if}}">
                            <i class="bi bi-check-circle"></i>
                            {{#if editMode}}Guardar cambios{{else}}Crear categoría{{/if}}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>