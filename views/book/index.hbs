<div class="row mb-3">
    <h1><i class="bi bi-book"></i> Libros</h1>
    <hr />
</div>

<div class="row mb-3">
    <div class="col-12">
        <a href="/books/create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Libro
        </a>
    </div>
</div>

{{#if hasBooks}}
<div class="row">
    {{#each booksList}}
    <div class="col-12 col-sm-4 col-md-4 mb-4">
        <div class="card shadow-sm">
            {{#if this.coverImage}}
            <img src="{{this.coverImage}}" class="card-img-top" alt="Portada de {{this.title}}" style="height: 200px; object-fit: cover;">
            {{else}}
            <div class="d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                <i class="bi bi-book fs-1 text-muted"></i>
            </div>
            {{/if}}
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-book-fill"></i> {{this.title}}</h5>
                <p class="text-muted small">
                    <i class="bi bi-person me-1"></i>Autor: {{this.Author.name}}
                </p>
                <p class="text-muted small">
                    <i class="bi bi-tag me-1"></i>Categoría: {{this.Category.name}}
                </p>
                <p class="text-muted small">
                    <i class="bi bi-building me-1"></i>Editorial: {{this.Publisher.name}}
                </p>
                <p class="text-muted small">
                    <i class="bi bi-calendar me-1"></i>Año: {{this.publicationYear}}
                </p>
                <div class="mt-3 d-flex gap-2">
                    <a href="/books/edit/{{this.id}}" class="btn btn-primary btn-sm">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <form action="/books/delete" method="POST">
                        <input type="hidden" name="bookId" value="{{this.id}}">
                        <button type="submit" class="btn btn-danger btn-sm confirm-delete">
                            <i class="bi bi-trash3"></i> Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>
{{else}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-5">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay libros registrados.
        </div>
    </div>
</div>
{{/if}}

{{#section "scripts"}}
<script>
    document.querySelectorAll(".confirm-delete").forEach((btn) => {
        btn.addEventListener("click", function (e) {
            if (!confirm("¿Está seguro que desea eliminar este libro?")) {
                e.preventDefault();
            }
        });
    });
</script>
{{/section}}