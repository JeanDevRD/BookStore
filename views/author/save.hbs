<div class="row mb-3">
    <h1>{{#if editMode}}Editar autor{{else}}Crear autor{{/if}}</h1>
    <hr />
</div>

<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-7">

        {{#if error}}
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> {{error}}
        </div>
        {{/if}}

        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" action="/authors/{{#if editMode}}edit{{else}}create{{/if}}">
                    {{#if editMode}}
                    <input type="hidden" name="id" value="{{author.id}}">
                    {{/if}}
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">Nombre</label>
                        <input type="text" id="name" name="name" class="form-control"
                            value="{{#if editMode}}{{author.name}}{{else}}{{formData.name}}{{/if}}" required />
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Email</label>
                        <input type="email" id="email" name="email" class="form-control"
                            value="{{#if editMode}}{{author.email}}{{else}}{{formData.email}}{{/if}}" required />
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <a href="/authors/index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-{{#if editMode}}primary{{else}}success{{/if}}">
                            <i class="bi bi-check-circle"></i>
                            {{#if editMode}}Guardar cambios{{else}}Crear autor{{/if}}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
