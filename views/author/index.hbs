<div class="row mb-3">
    <h1><i class="bi bi-person"></i> Autores</h1>
    <hr />
</div>

<div class="row mb-3">
    <div class="col-12">
        <a href="/authors/create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Autor
        </a>
    </div>
</div>

{{#if hasAuthors}}
<div class="row">
    {{#each authorsList}}
    <div class="col-12 col-sm-4 col-md-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-person-fill"></i> {{this.name}}</h5>
                <p class="text-muted small">
                    <i class="bi bi-envelope me-1"></i>Email: {{this.email}}
                </p>
                <div class="mt-3 d-flex gap-2">
                    <a href="/authors/edit/{{this.id}}" class="btn btn-primary btn-sm">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <a href="/authors/delete/{{this.id}}" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash3"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/each}}
</div>
{{else}}
<div class="row d-flex justify-content-center">
    <div class="col-12 col-sm-5">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay autores registrados.
        </div>
    </div>
</div>
{{/if}}
